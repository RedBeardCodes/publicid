<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.redbeardcodes</groupId>
        <artifactId>redbeardcodes-publishing-parent</artifactId>
        <version>1.0.0</version>
        <relativePath/>
    </parent>

    <artifactId>publicid</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>PublicID</name>
    <description>URL-safe random identifiers suitable for public facing resources</description>
    <url>https://github.com/RedBeardCodes/publicid</url>

    <scm>
        <connection>scm:git:https://github.com/RedBeardCodes/publicid.git</connection>
        <developerConnection>scm:git:ssh://github.com/RedBeardCodes/publicid.git</developerConnection>
        <url>https://github.com/RedBeardCodes/publicid</url>
    </scm>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <!-- Project -->
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Dependencies -->
        <junit.version>6.1.0</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>

